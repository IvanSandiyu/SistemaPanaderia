@page "/login"
@layout LoginLayout

@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="card login-card shadow-lg border-0"
     style="width:100%; max-width:400px;">

    <div class="card-header bg-primary text-white text-center py-4 border-0">

        <i class="bi bi-shop-window display-3"></i>

        <h3 class="mb-0 mt-3">
            Sistema de Panadería
        </h3>

        <small class="opacity-75">
            Iniciar sesión
        </small>

    </div>

    <div class="card-body p-4">

        @if (MensajeError) {
            <div class="alert alert-danger d-flex align-items-center mb-4"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>
                    Usuario o contraseña incorrectos.
                </div>

            </div>
        }

        <div class="mb-3">

            <label class="form-label fw-semibold">
                <i class="bi bi-person-fill me-1 text-primary"></i>
                Usuario
            </label>

            <div class="input-group">

                <span class="input-group-text">
                    <i class="bi bi-person"></i>
                </span>

                <input class="form-control"
                       placeholder="admin"
                       @bind="Usuario"
                       @bind:event="oninput" />

            </div>

        </div>

        <div class="mb-4">

            <label class="form-label fw-semibold">
                <i class="bi bi-shield-lock-fill me-1 text-primary"></i>
                Contraseña
            </label>

            <div class="input-group">

                <span class="input-group-text">
                    <i class="bi bi-lock"></i>
                </span>

                <input type="password"
                       class="form-control"
                       placeholder="••••••••"
                       @bind="Contrasena" />

            </div>

        </div>

        <button class="btn btn-primary w-100"
                disabled="@Cargando"
                @onclick="IniciarSesion">

            @if (Cargando) {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Ingresando...</span>
            } else {
                <i class="bi bi-box-arrow-in-right me-2"></i>
                <span>Ingresar</span>
            }

        </button>

    </div>

    <div class="card-footer text-center bg-white border-0 pb-4">

        <small class="text-muted">
            Gestión de productos, stock y ventas
        </small>

    </div>

</div>

@code {

    private string Usuario = "";
    private string Contrasena = "";
    private bool Cargando = false;
    private bool MensajeError = false;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();

        if (estado.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/");
    }

    private async Task IniciarSesion()
    {
        MensajeError = false;
        Cargando = true;

        try {

            var valido = await AuthService.Login(Usuario, Contrasena);

            if (valido) {
                Navigation.NavigateTo(ObtenerReturnUrl());
            } else {
                MensajeError = true;
            }

        } finally {
            Cargando = false;
        }
    }

    private string ObtenerReturnUrl()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');

        var returnUrl = query.Split('&')
            .Select(x => x.Split('='))
            .Where(x => x.Length == 2 && x[0] == "returnUrl")
            .Select(x => Uri.UnescapeDataString(x[1]))
            .FirstOrDefault();

        return string.IsNullOrWhiteSpace(returnUrl) ? "/" : returnUrl;
    }

}
